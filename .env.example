# Copy to .env and fill in the values: `cp .env.example .env`

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/base_malaya?schema=public"

# --- Next.js public base URL (used for local storage URLs) ---
NEXTAUTH_URL="http://localhost:3000"

# --- Auth.js ---
# Generate with: `openssl rand -base64 33`
AUTH_SECRET=""

# --- First admin (for `npm run db:seed`) ---
SEED_ADMIN_EMAIL="admin@basemalaya.club"
SEED_ADMIN_PASSWORD="changeme123"

# --- Email (Resend) — used for application approval notifications ---
RESEND_API_KEY=""
EMAIL_FROM="BASE Malaya Club <noreply@example.com>"

# ──────────────────────────────────────────────────────────────────────────────
# Cloudflare R2 — media storage (avatars + gallery)
#
# Leave ALL R2_* vars empty in development to use local storage instead:
#   - Files are saved to public/uploads/ and served from http://localhost:3000/uploads/
#   - No Cloudflare account or internet needed for local dev
#
# To use R2 (production or when testing against real storage):
#   1. Create an R2 bucket in your Cloudflare dashboard.
#   2. Enable "Public Access" or set up a custom domain on the bucket.
#   3. Create an API token with Object Read & Write permissions.
#   4. Fill in the values below.
# ──────────────────────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=""          # Found in Cloudflare dashboard → R2 → Overview
R2_ACCESS_KEY_ID=""       # R2 API token Access Key ID
R2_SECRET_ACCESS_KEY=""   # R2 API token Secret Access Key
R2_BUCKET=""              # Bucket name, e.g. "base-malaya-media"
R2_PUBLIC_URL=""          # Public bucket URL, e.g. "https://media.basemalaya.club"
                          # or the default *.r2.dev URL if no custom domain yet
